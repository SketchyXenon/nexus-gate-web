# =====================================================================
# Nexus Gate - Example Environment Variables
# ---------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Generate secrets: openssl rand -base64 32 (one per secret line below).
#
# ARCHITECTURE (split-target):
#   - Auth STAYS on Supabase (auth.users, sessions, JWT, email flows).
#   - App data tables live in DATABASE_URL (Postgres now, TiDB later).
#   - The Prisma client is auto-generated for the right provider by
#     scripts/postinstall.mjs based on DATABASE_URL's protocol.
# =====================================================================

# =====================================================================
# DATABASE  (REQUIRED)
# ---------------------------------------------------------------------
# Set DATABASE_URL to ONE of the backends below. The protocol determines
# which Prisma schema + connector the app uses:
#   postgresql://  -> prisma/schema.prisma        (Supabase Postgres)
#   mysql://       -> prisma/schema.tidb.prisma   (TiDB Serverless)
#   file:          -> prisma/schema.sqlite.prisma (local dev only)
#
# --- Local dev (SQLite - default) ---
# Keep this for local development. The app + Prisma client use SQLite.
DATABASE_URL="file:./db/custom.db"
#
# --- Option A: Supabase Postgres (production) ---
# Get from Supabase Dashboard > Settings > Database > Connection string.
# Transaction URL (port 6543, PgBouncer pooling - for the app):
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
#
# --- Option B: TiDB Serverless (production, after migration) ---
# Get from tidb.com > your cluster > Connect.
# In production on Vercel: set DATABASE_URL to the TiDB URL below.
# scripts/postinstall.mjs auto-detects mysql:// and builds the TiDB client.
# DATABASE_URL="mysql://[USER]:[PASSWORD]@[GATEWAY].tidb.com:4000/[DBNAME]?sslaccept=strict"
#
# --- TiDB schema management (local dev only) ---
# schema.tidb.prisma reads TIDB_DATABASE_URL (NOT DATABASE_URL) so you can
# keep DATABASE_URL=SQLite for local dev while pushing the TiDB schema to
# your TiDB cluster. Set this to your TiDB connection string, then run:
#   bun run db:push:tidb       (create the 13 tables on TiDB)
#   bun run db:generate:tidb   (build the MySQL Prisma client for testing)
# In production this is NOT needed - postinstall.mjs maps DATABASE_URL
# to TIDB_DATABASE_URL automatically when DATABASE_URL starts with mysql://.
# See docs/tidb-migration-runbook.md for the full cutover procedure.
#
# IMPORTANT: Percent-encode special characters in your TiDB password!
# TiDB Serverless passwords contain chars like @ # : $ / ? % + &.
# Prisma's MySQL URL parser REQUIRES these to be encoded or you get
# "P1013: invalid IPv6 address in database URL".
# Use the helper:  node scripts/encode-tidb-url.mjs
# Or encode manually: @ -> %40, # -> %23, : -> %3A, $ -> %24, / -> %2F
# Example: pass "aB3$xY9@pQ" -> "aB3%24xY9%40pQ"
TIDB_DATABASE_URL="mysql://[USER]:[ENC_PASSWORD]@[GATEWAY].tidb.com:4000/[DBNAME]?sslaccept=strict"
#
# --- Migration source (only for `bun run migrate:tidb`) ---
# The Supabase Postgres connection to copy data FROM during migration.
# Leave commented out unless you are actively running the migration script.
# SOURCE_DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
#
# --- Read replica (optional, Postgres only) ---
# Routes dashboard/stats heavy reads to a Supabase read replica. Leave
# empty to use the primary. Not used when DATABASE_URL is TiDB.
# DATABASE_REPLICA_URL=""

# =====================================================================
# AUTH SECRETS  (REQUIRED)
# ---------------------------------------------------------------------
# Used by the legacy HMAC helpers in src/lib/auth.ts (QR token signing,
# scan certificates). Supabase Auth handles sessions/passwords/email.
# Generate each with: openssl rand -base64 32
# =====================================================================
AUTH_SECRET="replace-with-random-32-byte-secret"
REFRESH_SECRET="replace-with-different-random-32-byte-secret"

# =====================================================================
# APP URL  (REQUIRED in production)
# ---------------------------------------------------------------------
# Used in email redirects, magic links, and the CSRF same-origin check.
# Set to your production URL (https://yourapp.vercel.app) when deployed.
# =====================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =====================================================================
# SUPABASE AUTH  (REQUIRED - stays on Supabase regardless of DB backend)
# ---------------------------------------------------------------------
# Get from Supabase Dashboard > Settings > API.
# These NEVER change when migrating app data to TiDB - auth stays here.
#   NEXT_PUBLIC_SUPABASE_URL    - project URL (https://xxx.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY - anon/public key (safe for browser)
#   SUPABASE_SERVICE_ROLE_KEY   - service role key (SERVER ONLY, bypasses RLS)
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: JWT local validation. Eliminates the supabase.auth.getUser()
# network round-trip on every authed request (saves 50-150ms). Get the
# secret from Supabase Dashboard > Settings > API > JWT Secret.
# SUPABASE_JWT_SECRET=""

# =====================================================================
# RATE LIMITING  (optional - falls back to in-memory if not set)
# ---------------------------------------------------------------------
# Upstash Redis (free tier). Strongly recommended for production:
# in-memory rate limiting does not work across serverless instances.
# Get from upstash.com > your database.
# =====================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =====================================================================
# EMAIL (SMTP)  (optional - required for forgot-password + magic links)
# ---------------------------------------------------------------------
# Gmail SMTP example. For production, use a transactional provider
# (Resend, Postmark, SendGrid). App passwords required for Gmail.
# =====================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="Nexus Gate"

# =====================================================================
# REALTIME  (optional - Ably, for live attendance updates)
# ---------------------------------------------------------------------
# Get from https://ably.com/dashboard > your app > API Keys.
# Format: keyName:keySecret (e.g. appId.keyId:secret). Copy the FULL key.
# This is the ONLY Ably env var - the browser uses token auth via
# /api/ably/token (signed server-side). Do NOT set NEXT_PUBLIC_ABLY_KEY.
# =====================================================================
ABLY_SERVER_KEY=""

# =====================================================================
# ERROR MONITORING  (optional - Sentry)
# ---------------------------------------------------------------------
# Get from sentry.io > your project > Settings > Client Keys.
# NEXT_PUBLIC_SENTRY_DSN is safe for the browser bundle.
# SENTRY_DSN is server-only (do not expose to client).
# =====================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# =====================================================================
# CLOUDFLARE TURNSTILE  (optional - bot protection on auth forms)
# ---------------------------------------------------------------------
# Get from cloudflare.com > Turnstile > your site.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe for the browser.
# TURNSTILE_SECRET_KEY is server-only (do not expose to client).
# If unset, Turnstile verification is skipped (dev/local only).
# =====================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# =====================================================================
# CRON SECRET  (REQUIRED in production)
# ---------------------------------------------------------------------
# Protects /api/cron/* endpoints (cleanup, event reminders). Vercel Cron
# sends this as the Authorization: Bearer header. Generate with:
#   openssl rand -base64 32
# Set the same value in vercel.json cron config or Vercel dashboard.
# =====================================================================
CRON_SECRET="replace-with-random-32-byte-secret"

# =====================================================================
# BOOTSTRAP ADMIN  (optional - one-time setup)
# ---------------------------------------------------------------------
# Used by `bun run bootstrap:admin` to create the first ADMIN account.
# Set these once, run the script, then unset (don't leave credentials in .env).
# Auth creates a Supabase Auth user; the accounts row goes to DATABASE_URL.
# =====================================================================
# BOOTSTRAP_ADMIN_EMAIL="admin@yourschool.edu"
# BOOTSTRAP_ADMIN_PASSWORD="StrongPassword123!"
# BOOTSTRAP_ADMIN_NAME="System Administrator"

# =====================================================================
# QUICK START CHECKLIST
# ---------------------------------------------------------------------
# Local dev (SQLite):
#   1. DATABASE_URL="file:./db/custom.db"  (already set in .env)
#   2. bun install && bun run db:push:sqlite
#   3. Set NEXT_PUBLIC_SUPABASE_* + SUPABASE_SERVICE_ROLE_KEY
#   4. bun run bootstrap:admin
#   5. bun run dev
#
# Production (Supabase Postgres):
#   1. DATABASE_URL = Supabase Transaction URL (port 6543)
#   2. Set all REQUIRED vars above (Supabase, AUTH_SECRET, REFRESH_SECRET,
#      CRON_SECRET, NEXT_PUBLIC_APP_URL)
#   3. Deploy to Vercel - postinstall.mjs auto-builds the Postgres client
#
# Production (TiDB - after migration):
#   1. DATABASE_URL = TiDB connection (mysql:// or mysqls://)
#   2. Keep all Supabase vars (auth stays on Supabase)
#   3. Deploy to Vercel - postinstall.mjs auto-builds the TiDB client
#   4. See docs/tidb-migration-runbook.md for the full cutover procedure
# =====================================================================

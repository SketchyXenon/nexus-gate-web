{
  "name": "nexus-gate",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npx --no-install prisma generate --schema=prisma/schema.sqlite.prisma && next dev -p 3000",
    "build": "node scripts/postinstall.mjs && next build",
    "build:tidb": "npx --no-install prisma generate --schema=prisma/schema.tidb.prisma && next build",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash tests/e2e/run-e2e.sh",
    "test:scan": "bash tests/e2e/scan-endpoints.sh",
    "test:all": "vitest run && bash tests/e2e/scan-endpoints.sh && bash tests/e2e/run-e2e.sh",
    "bootstrap:admin": "bun run scripts/bootstrap-admin.ts",
    "seed:events": "bun run scripts/seed-events.ts",
    "migrate:tidb": "bun run scripts/migrate-to-tidb.ts",
    "db:push": "npx --no-install prisma db push",
    "db:push:sqlite": "npx --no-install prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:push:tidb": "npx --no-install prisma db push --schema=prisma/schema.tidb.prisma",
    "db:generate": "npx --no-install prisma generate",
    "db:generate:sqlite": "npx --no-install prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:generate:tidb": "npx --no-install prisma generate --schema=prisma/schema.tidb.prisma",
    "db:migrate": "npx --no-install prisma migrate dev",
    "db:reset": "npx --no-install prisma migrate reset"
  },

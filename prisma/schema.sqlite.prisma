// ====================================================================
// Nexus Gate - LOCAL DEV schema (SQLite)
// --------------------------------------------------------------------
// This schema is used ONLY for local development (`bun run dev`).
// It uses the SQLite provider so the app runs against a local file DB
// without needing a Postgres instance.
//
// The PRODUCTION schema is `prisma/schema.prisma` (PostgreSQL + @map
// annotations matching the Supabase migrations). Vercel's build
// generates the client from `schema.prisma` (postgres). The local
// `dev` script generates the client from THIS file (sqlite) instead.
//
// IMPORTANT: This file has NO @map/@@map annotations because the local
// SQLite database was created by `prisma db push` against this exact
// schema, so its tables/columns use Prisma's default PascalCase /
// camelCase naming. The two schemas describe the SAME models - they
// only differ in provider + physical column names.
//
// When adding/removing a field, update BOTH schema files identically
// (field names, types, relations, indexes) - only the provider and
// @map annotations differ.
// ====================================================================

// Prisma 7 generator (prisma-client-js was removed). The generated
// client is provider-agnostic - the connection comes from a driver
// adapter at runtime (src/lib/db.ts: @prisma/adapter-better-sqlite3
// for local dev). The connection URL lives in prisma.config.ts.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "sqlite"
}

// ====================================================================
// 1. ACCOUNTS
// ====================================================================

model Account {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String        @default("")
  fullName        String
  role            String        @default("USER")
  status          String        @default("PENDING_VERIFICATION")
  studentId       Int?          @unique
  program         String?
  section         String?
  authProvider    String?
  providerAccountId String?
  year            Int?
  // Day/night class classification ("DAY" | "NIGHT"). Null = not yet set;
  // the schedules view then shows both shifts for the student's section.
  shift           String?
  organizationName String?
  courseModifiedAt DateTime?
  lastProfileUpdateAt DateTime?
  lastPasswordChangeAt DateTime?
  notificationEndpoint String?
  notificationKeys     String?
  passkeyCredential    String?
  passkeyCredentialId  String?  @unique
  supabaseAuthUid      String?  @unique
  // MFA (TOTP, RFC 6238). Optional per account. Secret is AES-256-GCM
  // encrypted at rest (mfa.ts encryptSecret/decryptSecret). The plaintext
  // secret never persists; only the base64 ciphertext+iv+tag blob does.
  mfaSecretEnc        String?
  mfaEnabled          Boolean  @default(false)
  mfaEnabledAt        DateTime?
  // JSON array of bcrypt-hashed one-time backup codes (generateBackupCodes).
  // SQLite has no native JSON column type - we store the serialized array.
  mfaBackupCodesHash  String?
  notificationEnabled  Boolean  @default(false)
  notificationPrefs    String? // JSON string (SQLite has no native JSON type)
  lastLoginAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil     DateTime?
  // Email verification timestamp (set when user clicks the verification link).
  emailVerifiedAt DateTime?
  // Soft-delete / deactivation fields (never hard-delete user data).
  isDeactivated   Boolean       @default(false)
  deactivatedAt   DateTime?
  deactivatedReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  eventsOwned       Event[]
  attendances       EventAttendance[]
  overridesMade     AttendanceOverride[] @relation("OverrideCreator")
  notifications     Notification[]
  auditLogs         AuditLog[]
  verificationTokens VerificationToken[]
  refreshTokens     RefreshToken[]
  deviceKeys        DeviceKey[]
  termsAcceptances  TermsAcceptance[]
  mfaChallenges     MfaChallenge[]
  schedulesOwned    Schedule[] @relation("ScheduleOwner")

  @@index([role, status])
  @@index([program, section])
  @@index([notificationEnabled])
  @@index([lockedUntil])
  @@index([lastLoginAt])
  // Passkey login: O(log N) lookup by credential ID (mirrors Postgres schema)
  @@index([passkeyCredentialId])
  // Admin roster sort (mirrors Postgres schema)
  @@index([createdAt])
  // Deactivation filter: list active accounts excluding soft-deleted
  @@index([isDeactivated])
}

// ====================================================================
// 2. AUTHORIZED STUDENTS
// ====================================================================

model AuthorizedStudent {
  studentId   Int      @id
  email       String   @unique
  fullName    String
  program     String
  section     String
  // Day/night class shift ("DAY" | "NIGHT"). Defaults to DAY for imports
  // that do not specify one (day students are the historical majority).
  shift       String   @default("DAY")
  activated   Boolean  @default(false)
  overrides   AttendanceOverride[]

  @@index([program, section, activated])
  @@index([activated])
  @@index([shift])
}

// ====================================================================
// 3. VERIFICATION TOKENS
// ====================================================================

model VerificationToken {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  attempts  Int      @default(0)

  @@index([accountId, purpose, usedAt])
  @@index([expiresAt])
}

// ====================================================================
// 4. REFRESH TOKENS
// ====================================================================

model RefreshToken {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

// ====================================================================
// 5. EVENTS
// ====================================================================

model Event {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  eventSecret   String    @default(cuid())
  ownerId       String
  owner         Account   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  scope         String    @default("academic")
  targetProgram String?
  targetSection String?
  scheduledAt   DateTime
  endsAt        DateTime?
  checkInOpensAt   DateTime?
  checkInClosesAt  DateTime?
  timeOutOpensAt   DateTime?
  timeOutClosesAt  DateTime?
  enableTimeOut    Boolean   @default(false)
  delegatable      Boolean   @default(true)
  delegationEnabled Boolean  @default(false)
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  attendances EventAttendance[]
  overrides   AttendanceOverride[]

  @@index([status, scheduledAt])
  @@index([ownerId, status])
  // Organizer dashboard sorted view (mirrors Postgres schema)
  @@index([ownerId, status, scheduledAt])
  @@index([targetProgram, targetSection, status])
  @@index([scheduledAt, status])
}

// ====================================================================
// 6. EVENT ATTENDANCE
// ====================================================================

model EventAttendance {
  id             Int      @id @default(autoincrement())
  eventId        Int
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scannedAt      DateTime @default(now())
  timeOutAt      DateTime?
  source         String   @default("qr")
  idempotencyKey String?  @unique
  tokenBlock     Int?

  certificateNonce     String?  @unique
  certificateSubFrames String?
  deviceFingerprint    String?
  scannedAtClient      DateTime?

  @@unique([eventId, accountId])
  @@index([accountId, scannedAt])
  @@index([eventId, scannedAt])
  @@index([scannedAt])
  @@index([deviceFingerprint])
}

// ====================================================================
// 7. ATTENDANCE OVERRIDES
// ====================================================================

model AttendanceOverride {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // v16: renamed admin -> creator (organizers can now create overrides
  // too). Table was empty in dev - plain rename, no migration needed.
  creatorId   String
  creator     Account  @relation("OverrideCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  studentId   Int
  student     AuthorizedStudent @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  reason      String
  // Server receipt time (when the certificate was synced/accepted)
  createdAt   DateTime @default(now())

  // ---- v16 anti-cheat forensics (offline-first signed certificates) ----
  clientCreatedAt   DateTime?
  deviceFingerprint String?
  syncDelayMs       Int?
  clockDriftMs      Int?
  offline           Boolean  @default(false)

  @@index([eventId, createdAt])
  @@index([creatorId, createdAt])
  @@index([offline, createdAt])
  @@unique([eventId, studentId])
}

// ====================================================================
// 8. NOTIFICATIONS
// ====================================================================

model Notification {
  id          Int      @id @default(autoincrement())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        String   @default("info")
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, readAt])
  @@index([readAt, createdAt])
  @@index([type, createdAt])
}

// ====================================================================
// 9. AUDIT LOG
// ====================================================================

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String?
  actor      Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

// ====================================================================
// 10. DEVICE KEYS
// ====================================================================

model DeviceKey {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  publicKeyJwk String
  fingerprint  String    @unique
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  @@index([accountId, revokedAt])
}

// ====================================================================
// 11. SETTINGS
// ====================================================================

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ====================================================================
// 12. TERMS ACCEPTANCES (immutable compliance record)
// ====================================================================

model TermsAcceptance {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  termsVersion String
  termsHash   String
  policyVersion String
  policyHash  String
  ipAddress   String?
  userAgent   String?
  acceptedAt  DateTime @default(now())

  @@index([accountId, acceptedAt])
}

// ====================================================================
// 13. VISIT ANALYTICS (privacy-preserving)
// --------------------------------------------------------------------
// No raw IP address is ever stored. The public IP is HMAC-hashed with a
// daily-rotating server secret, producing a non-reversible token that
// only identifies "same visitor on the same day" - nothing more. Per
// 06-security-architecture.md §8 (data minimization) and §11 (never log
// full PII). Aggregated upserts deduplicate on (dayBucket, visitorHash,
// route), so the row count stays bounded.
// ====================================================================

model Visit {
  id           String   @id @default(cuid())
  dayBucket    String   // YYYY-MM-DD (UTC)
  visitorHash  String   // HMAC(secret, ip) - non-reversible, daily-rotating
  route        String   // path visited (e.g. "/" or "/api/events")
  country      String?  // optional, from CF-IPCountry header (country-level only)
  visits       Int      @default(1) // upserted counter
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@unique([dayBucket, visitorHash, route])
  @@index([dayBucket])
  @@index([route])
}

// ====================================================================
// 14. MFA CHALLENGES (TOTP, RFC 6238)
// --------------------------------------------------------------------
// A short-lived row created at /api/auth/login when account.mfaEnabled.
// The login-verify route reads + consumes it within a 5-minute window.
// `attempts` is bumped on each failed verify so we can lock the
// challenge after 5 failures. `consumedAt` is set on success, lockout,
// or expiry, so the challengeJwt can be replayed only until consumed.
// ====================================================================

model MfaChallenge {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([accountId, consumedAt])
  @@index([expiresAt])
}

// ====================================================================
// 15. SCHEDULES (recurring weekly class timetable, day & night shifts)
// --------------------------------------------------------------------
// Institutions here run DAY and NIGHT class shifts for the same
// program/section. Each Schedule row is one recurring weekly class slot:
//   - shift       "DAY" (06:00-17:59) or "NIGHT" (18:00-23:59)
//   - dayOfWeek   0 = Sunday ... 6 = Saturday (matches Date#getDay())
//   - start/endTime "HH:MM" 24h strings (zero-padded, so lexicographic
//     ordering = chronological). Stored as strings because Prisma has no
//     time-only scalar and the value must round-trip identically across
//     SQLite (dev) and TiDB (prod).
//   - program/section mirror Event.targetProgram/targetSection: both null
//     = department-wide, section null = program-wide, both set = section
//     class. Combined with shift, students in e.g. "BSIT 3-A" get the
//     correct DAY or NIGHT timetable for their population.
// ====================================================================

model Schedule {
  id         Int      @id @default(autoincrement())
  ownerId    String
  owner      Account  @relation("ScheduleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  program    String?
  section    String?
  shift      String   @default("DAY")
  dayOfWeek  Int
  subject    String
  instructor String?
  room       String?
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Exact-duplicate guard (idempotent create / double-submit): one subject
  // per (section, shift, day, start) slot. SQLite unique indexes allow
  // multiple NULLs, so open-scope (program=null) rows are not deduplicated
  // at the DB level - the API layer backstops that case.
  @@unique([program, section, shift, dayOfWeek, startTime, subject])
  @@index([program, section, shift, dayOfWeek, isActive])
  @@index([ownerId, createdAt])
  @@index([shift, isActive])
}

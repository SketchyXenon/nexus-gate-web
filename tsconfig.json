{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Prisma 7's new `prisma-client` generator emits `.ts`-extension
    // relative imports (importFileExtension = "ts") because Turbopack
    // resolves the literal specifier. Allowed here because noEmit is on.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mini-services",
    "examples",
    "skills",
    // Test files are executed by vitest (which type-checks nothing) and
    // must never fail a production `next build` on Vercel - a stale test
    // import used to deploy-block the whole app (TS2305 @prisma/client).
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
